# Compose 内部通过 postgres 服务名连接数据库；密码请替换为随机长字符串。
POSTGRES_DB=tapd_dingding
POSTGRES_USER=tapd_app
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgres://tapd_app:replace-with-a-long-random-password@postgres:5432/tapd_dingding?sslmode=disable

APP_ENCRYPTION_KEY=replace-with-generated-32-byte-base64-key

# Compose 会在 tapd-mcp 服务中启动 TAPD MCP；Token 请勿提交到 Git。
TAPD_ACCESS_TOKEN=replace-with-tapd-access-token
TAPD_MCP_URL=http://tapd-mcp:8000/mcp/
APP_PORT=8080

# 日志默认输出 JSON；本地调试可改为 text。级别支持 debug/info/warn/error。
LOG_FORMAT=json
LOG_LEVEL=info
