# Compose 内部通过 postgres 服务名连接数据库；密码请替换为随机长字符串。
POSTGRES_DB=tapd_dingding
POSTGRES_USER=tapd_app
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgres://tapd_app:replace-with-a-long-random-password@postgres:5432/tapd_dingding?sslmode=disable

APP_ENCRYPTION_KEY=replace-with-generated-32-byte-base64-key

# 如果 TAPD MCP 在宿主机 8000 端口运行，使用 host.docker.internal；
# 如果 MCP 在其他容器中运行，请改成对应的 Compose 服务名和端口。
TAPD_MCP_URL=http://host.docker.internal:8000/mcp/
APP_PORT=8080
